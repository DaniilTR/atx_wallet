# ---- App ----
APP_NAME=ATX_AI
APP_ENV=dev

# Comma-separated list. Example: http://localhost:5173,http://localhost:3000
CORS_ORIGINS=

# ---- Auth (JWT) ----
# Supported: HS256 (JWT_SECRET) or RS256 (JWT_PUBLIC_KEY)
JWT_ALG=HS256
JWT_SECRET=change_me
JWT_PUBLIC_KEY=

# Optional checks
JWT_ISSUER=
JWT_AUDIENCE=

# MVP без аккаунтов: один общий токен вместо настоящего JWT.
# Клиент будет отправлять: Authorization: Bearer <этот_токен>
SHARED_BEARER_TOKEN=

# ---- Rate limiting ----
# SlowAPI syntax examples: 10/second, 60/minute, 100/hour
RATE_LIMIT=30/minute

# ---- Knowledge base / RAG ----
KNOWLEDGE_BASE_PATH=data/knowledge_base.json
RAG_TOP_K=5

# If you want to treat near-duplicates as EXACT matches, set like 95.
# If empty/0 -> only strict normalized string match.
FUZZY_EXACT_THRESHOLD=95

# ---- Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

SHARED_BEARER_TOKEN=qweasdrtyfghd123dass234asdqwe435vxcwerfbvxsgdf687