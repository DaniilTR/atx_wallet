# На каком адресе слушать
HOST=0.0.0.0
PORT=8080

# Куда ходим за данными (CoinGecko)
COINGECKO_BASE_URL=https://api.coingecko.com

# Разрешённые Origin для CORS (через запятую). Пусто = разрешить всё.
CORS_ORIGINS=

# Время жизни кэша (сек)
CACHE_TTL_SECONDS=300
# Сколько можно отдавать "протухший" кэш, если апстрим сломался (сек)
CACHE_STALE_SECONDS=86400

# Бэкапы кэша (на всякий случай)
# Интервал создания снапшотов кэша (сек). 12 часов => 2 снапшота в сутки.
CACHE_SNAPSHOT_INTERVAL_SECONDS=43200
# Сколько снапшотов хранить на одну дату (обычно 2: дневной и ночной)
CACHE_SNAPSHOTS_PER_DAY=2
# Сколько дней хранить дневные файлы кэша. 0 = не чистить (хранить всегда)
CACHE_DAILY_RETENTION_DAYS=0

# Интервал фонового обновления простых цен для PRELOAD_SIMPLE_PRICE_IDS (сек)
REFRESH_INTERVAL_SECONDS=240
# Какие coin ids предзагружать по simple/price
PRELOAD_SIMPLE_PRICE_IDS=bitcoin,ethereum,tether

# market_chart (графики)
# Для этих монет и days сервер создаёт отдельные файлы кэша:
# data/cache/coingecko/market_chart/<coinId>/days_<N>.json
MARKET_CHART_COINS=bitcoin,ethereum,solana,ripple,binancecoin,litecoin,cosmos,tron
MARKET_CHART_DAYS=1,7,30,365

# Новости (Cointelegraph RU)
# Как часто обновлять RSS в фоне (сек)
NEWS_REFRESH_INTERVAL_SECONDS=3600
# Сколько новостей отдавать (10-15 обычно достаточно)
NEWS_LIMIT=15
# TTL кэша новостей (сек)
NEWS_TTL_SECONDS=3600
# Сколько можно отдавать "старые" новости, если RSS не доступен (сек)
NEWS_STALE_SECONDS=86400

# Таймаут исходящих запросов к апстриму (мс)
UPSTREAM_TIMEOUT_MS=10000

# Уровень логов
LOG_LEVEL=info
