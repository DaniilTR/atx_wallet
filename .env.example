# На каком адресе слушать
HOST=0.0.0.0
PORT=8080

# Куда ходим за данными (CoinGecko)
COINGECKO_BASE_URL=https://api.coingecko.com

# Разрешённые Origin для CORS (через запятую). Пусто = разрешить всё.
CORS_ORIGINS=

# Время жизни кэша (сек)
CACHE_TTL_SECONDS=300
# Сколько можно отдавать "протухший" кэш, если апстрим сломался (сек)
CACHE_STALE_SECONDS=86400

# Интервал фонового обновления простых цен для PRELOAD_SIMPLE_PRICE_IDS (сек)
REFRESH_INTERVAL_SECONDS=240
# Какие coin ids предзагружать по simple/price
PRELOAD_SIMPLE_PRICE_IDS=bitcoin,ethereum,tether

# Таймаут исходящих запросов к апстриму (мс)
UPSTREAM_TIMEOUT_MS=10000

# Уровень логов
LOG_LEVEL=info
